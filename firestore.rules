rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // files コレクションのルール
    match /files/{fileId} {
      allow read: if true;  // 誰でも読み取り可能
      allow write: if request.auth != null;  // 認証済みユーザーのみ書き込み可能
    }
    
    // その他のコレクションのルール
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}